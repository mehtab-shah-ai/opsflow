# =================================================================
# OpsFlow AI - Environment Variables Reference (.env.example)
# =================================================================

# 1. Primary High-Speed AI Engine: Groq
# Get free API key from: https://console.groq.com/keys
GROQ_API_KEY_1=your_groq_api_key_here
GROQ_API_KEY_2=your_secondary_groq_api_key_optional
GROQ_MODEL=openai/gpt-oss-20b
GROQ_REASONING_MODEL=openai/gpt-oss-120b

# 2. Secondary AI Engine: Google Gemini
# Get free API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_SECONDARY=your_secondary_gemini_api_key_optional
GEMINI_MODEL=gemini-2.5-flash
GEMINI_REASONING_MODEL=gemini-2.5-flash

# 3. Web Intelligence & Enrichment (Optional)
TAVILY_API_KEY_1=your_tavily_api_key_optional
FIRECRAWL_API_KEY_1=your_firecrawl_api_key_optional

# 4. Storage & Persistence
# For local development: leave blank or set to local path
# On Render Web Service: set to /tmp/opsflow_runtime
RUNTIME_DIR=runtime

# 5. Security & Isolation
# Secret key used for signing workspace session tokens
JWT_SECRET=opsflow-grace-secret-key-change-in-production
